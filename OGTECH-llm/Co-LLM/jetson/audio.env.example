# Jetson 실기 기준: 사용자 kit, 체크아웃 /home/kit/ogtech/OGTECH-llm/Co-LLM, 시스템 python3(3.8), venv 없음.
# jetson/*.service 가 EnvironmentFile=-/etc/ogtech/audio.env 로 읽습니다. 이 파일을 복사해 채우세요.

# scripts/00_check_audio.sh가 확인한 ALSA 카드 이름을 사용합니다.
# 카드 번호(hw:1,0)는 부팅마다 바뀌므로 금지합니다.
# 2026-08-30 실기: 마이크는 AB13X USB Audio(카드 id Audio), 스피커는 Jieli UACDemoV1.0(카드 id UACDemoV10).
# 같은 GNOME 세션의 키오스크 브라우저가 PulseAudio로 같은 USB 스피커를 열면 plughw: 직접 접근은
# "Device or resource busy"로 실패한다(실기 재현). 키오스크와 함께 쓰는 실기에서는 pulse 를 지정하고,
# pactl set-default-sink/-source 로 기본 장치를 USB 스피커/마이크로 맞춘다.
OGTECH_MIC_DEVICE=pulse
OGTECH_SPK_DEVICE=pulse
# PulseAudio 없이 Co-LLM만 단독 검증할 때의 직접 ALSA 이름:
#OGTECH_MIC_DEVICE=plughw:CARD=Audio,DEV=0
#OGTECH_SPK_DEVICE=plughw:CARD=UACDemoV10,DEV=0
# 실기 기본: sherpa-onnx KSS 여성 음성 → espeak 비상 폴백. MeloTTS/Piper가 설치된 장치는 sherpa,melotts,piper,espeak
OGTECH_TTS_ORDER=sherpa,espeak

# 모델 경로 기본값은 ~/ogtech_ai/... 이고, 없으면 구 설치 ~/safeaid_ai/... 를 자동으로 씁니다(config.py _ai_path).
# 둘 다 아니면 아래를 지정합니다.
#OGTECH_WHISPER_CPP_BIN=/home/kit/safeaid_ai/stt/whisper.cpp/build/bin/whisper-cli
#OGTECH_WHISPER_CPP_MODEL=/home/kit/safeaid_ai/stt/whisper.cpp/models/ggml-base.bin
#OGTECH_WHISPER_VAD_MODEL=/home/kit/safeaid_ai/stt/whisper.cpp/models/ggml-silero-v5.1.2.bin

# 녹음·TTS 캐시·파이프라인 락 출력 폴더. 기본은 코드 트리 scripts/test_rec 이며,
# 서비스 사용자가 거기에 쓸 수 없으면 지정합니다.
#OGTECH_RESULT_DIR=/home/kit/.cache/ogtech/co-llm
