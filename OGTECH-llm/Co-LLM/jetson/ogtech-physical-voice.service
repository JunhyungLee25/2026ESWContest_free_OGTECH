[Unit]
Description=OGTECH STM32 물리 음성 버튼 push-to-talk
After=sound.target ogtech-map.service
Requires=ogtech-map.service

[Service]
Type=simple
User=kit
SupplementaryGroups=audio
WorkingDirectory=/home/kit/ogtech/OGTECH-llm/Co-LLM
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/ogtech/audio.env
ExecStart=/usr/bin/python3 /home/kit/ogtech/OGTECH-llm/Co-LLM/scripts/physical_voice.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
