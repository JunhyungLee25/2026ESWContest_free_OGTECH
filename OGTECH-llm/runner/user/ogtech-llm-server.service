[Unit]
Description=OGTECH llama-server (사용자 서비스, 의도 분류 전용)
# After=default.target은 WantedBy=default.target과 순서 순환을 만든다(2026-08-30 실기 확인).
After=basic.target

[Service]
Type=simple
WorkingDirectory=%h/ogtech/OGTECH-llm
EnvironmentFile=-%h/.config/ogtech/llm.env
ExecStart=/usr/bin/env bash %h/ogtech/OGTECH-llm/runner/start_llama_server.sh --foreground
ExecStartPost=%h/ogtech/OGTECH-llm/runner/warmup_llm.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
